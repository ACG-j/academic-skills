# Nature (flagship): 89 mm single column, 5-7 pt text, Arial/Helvetica.
# Verify the live Nature figure guide before submission.
figure.figsize: 3.504, 2.60
font.size: 7
axes.titlesize: 7
axes.labelsize: 7
xtick.labelsize: 6
